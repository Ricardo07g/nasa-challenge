# Copie para .env (que NUNCA é commitado) e preencha só na sua máquina.
# cp .env.example .env

ENVIRONMENT=development
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# PostgreSQL + PostGIS. No docker compose isto já é preenchido automaticamente.
# Rodando a API fora do Docker, aponte para a porta exposta (padrão 5433):
# DATABASE_URL=postgresql://raiz:raiz_local@localhost:5433/raiz_orbital
DATABASE_URL=

# Token da Earthdata. Gere em https://urs.earthdata.nasa.gov, em "Generate Token".
# Só os scripts de dados de IMERG, SMAP e AppEEARS usam; a API não precisa dele (ADR-0005).
EARTHDATA_TOKEN=

# Legado (saem quando a ADR-0005 for aceita): login da Earthdata, trocado pelo token acima,
# e id do projeto do Google Earth Engine, que fica fora do MVP.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EE_PROJECT=

# Arquivos que a API lê (opcional). Sem valor, usa os que vêm em app/config_data e app/fixtures.
# CULTURAS_PATH=
# REGRAS_PATH=
# CLIMA_PATH=
# Caches por ponto do SoilGrids e do NDVI (MODIS). Sem valor: solo padrão e sem histórico.
# SOLO_CACHE_PATH=
# NDVI_CACHE_PATH=
