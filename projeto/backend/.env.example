# Copie para .env (que NUNCA é commitado) e preencha só na sua máquina.
# cp .env.example .env

ENVIRONMENT=development
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# PostgreSQL + PostGIS. No docker compose isto já é preenchido automaticamente.
# Rodando a API fora do Docker, aponte para a porta exposta (padrão 5433):
# DATABASE_URL=postgresql://raiz:raiz_local@localhost:5433/raiz_orbital
DATABASE_URL=

# Credenciais da NASA: só os scripts de dados usam; a API não precisa de nenhuma (ADR-0005).
# Token da Earthdata Login (vale 60 dias). Gere em https://urs.earthdata.nasa.gov, em
# "Generate Token". Serve para a NSIDC (SMAP) e o GES DISC (IMERG), NÃO para o AppEEARS.
EARTHDATA_TOKEN=

# Token do AppEEARS, de POST https://appeears.earthdatacloud.nasa.gov/api/login (vale cerca de 48 h).
# Sem ele, o script faz o login com EARTHDATA_USERNAME e EARTHDATA_PASSWORD.
APPEEARS_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Legado (sai quando a ADR-0005 for aceita): id do projeto do Google Earth Engine, fora do MVP.
EE_PROJECT=

# Arquivos que a API lê (opcional). Sem valor, usa os que vêm em app/config_data e app/fixtures.
# CULTURAS_PATH=
# REGRAS_PATH=
# CLIMA_PATH=
# Caches por ponto do SoilGrids e do NDVI (MODIS). Sem valor: solo padrão e sem histórico.
# SOLO_CACHE_PATH=
# NDVI_CACHE_PATH=
# Deltas do NEX-GDDP-CMIP6 (saída do pipeline/fetch_cmip6_deltas.py). Sem valor: sem nota de futuro,
# a não ser que o banco tenha os deltas da célula (tabela cmip6_delta).
# CMIP6_PATH=
# Fase do El Niño / La Niña de cada safrinha pelo ONI da NOAA (saída do pipeline/fetch_oni.py,
# sem credencial). Sem valor: o detalhe de cada ano sai sem a marca (enso: null).
# ONI_PATH=
# Região pelo satélite (P3, saída do pipeline/fetch_regiao_ndvi.py). Sem valor: /api/regiao
# responde 404 OUTSIDE_AREA.
# REGIAO_PATH=
