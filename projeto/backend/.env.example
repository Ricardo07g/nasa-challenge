# Copie para .env (que NUNCA é commitado) e preencha só na sua máquina.
# cp .env.example .env

ENVIRONMENT=development
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Earthdata Login (https://urs.earthdata.nasa.gov) - IMERG e SMAP
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Google Earth Engine - id do projeto do Google Cloud
EE_PROJECT=
