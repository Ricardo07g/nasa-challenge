# Copie para .env (que NUNCA é commitado) e preencha só na sua máquina.
# cp .env.example .env

ENVIRONMENT=development
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# PostgreSQL + PostGIS. No docker compose isto já é preenchido automaticamente.
# Rodando a API fora do Docker, aponte para a porta exposta (padrão 5433):
# DATABASE_URL=postgresql://raiz:raiz_local@localhost:5433/raiz_orbital
DATABASE_URL=

# Credenciais da NASA: só os scripts de dados usam; a API não precisa de nenhuma (ADR-0005).
# Token da Earthdata Login (vale 60 dias). Gere em https://urs.earthdata.nasa.gov, em
# "Generate Token". Serve para a NSIDC (SMAP) e o GES DISC (IMERG), NÃO para o AppEEARS.
EARTHDATA_TOKEN=

# Token do AppEEARS, de POST https://appeears.earthdatacloud.nasa.gov/api/login (vale cerca de 48 h).
# Sem ele, o script faz o login com EARTHDATA_USERNAME e EARTHDATA_PASSWORD.
APPEEARS_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Legado (sai quando a ADR-0005 for aceita): id do projeto do Google Earth Engine, fora do MVP.
EE_PROJECT=

# Sal do hash do identificador do aparelho nos relatos da comunidade (tarefa 0047). É segredo:
# gere um valor longo e aleatório só na sua máquina ou no servidor, por exemplo com
# python -c "import secrets; print(secrets.token_hex(32))", e nunca o commite.
# Vazio: sal aleatório por processo (o limite por dia e o "apagar o meu" recomeçam quando a API
# reinicia).
COMMUNITY_DEVICE_SALT=

# Commit que está no ar, devolvido pelo /api/health. Não preencha: o CI grava na Railway a cada
# deploy (.github/scripts/railway-deploy.sh). Sem valor, "local".
# COMMIT_SHA=

# Arquivos que a API lê (opcional). Sem valor, usa os que vêm em app/config_data e app/fixtures.
# CULTURAS_PATH=
# REGRAS_PATH=
# CLIMA_PATH=
# Caches por ponto do SoilGrids e do NDVI (MODIS). Sem valor: solo padrão e sem histórico.
# SOLO_CACHE_PATH=
# NDVI_CACHE_PATH=
# NDVI do MODIS por área, em ladrilhos (saída do pipeline/fetch_ndvi_area.py, sem credencial):
# o índice. Sem valor: só o NDVI_CACHE_PATH, por ponto.
# NDVI_AREA_PATH=
# Deltas do NEX-GDDP-CMIP6 (saída do pipeline/fetch_cmip6_deltas.py). Sem valor: sem nota de futuro,
# a não ser que o banco tenha os deltas da célula (tabela cmip6_delta).
# CMIP6_PATH=
# Fase do El Niño / La Niña de cada safrinha pelo ONI da NOAA (saída do pipeline/fetch_oni.py,
# sem credencial). Sem valor: o detalhe de cada ano sai sem a marca (enso: null).
# ONI_PATH=
# Região pelo satélite (P3, saída do pipeline/fetch_regiao_ndvi.py). Sem valor: /api/regiao
# responde 404 OUTSIDE_AREA.
# REGIAO_PATH=
# Chuva dos últimos 30 dias pelo IMERG Late, por célula (saída do pipeline/fetch_imerg_late.py).
# Sem valor: o sinal para o outono fica sem o dado da terra agora.
# IMERG_LATE_PATH=
# Umidade do SMAP L4 nos dias de semeadura (saída do pipeline/fetch_smap.py). Sem valor: o balde
# começa em 50% da CAD, a não ser que o banco tenha a série da célula (tabela smap_point).
# SMAP_PATH=
# SMAP recente com o percentil (saída do pipeline/fetch_smap.py --recente), para o sinal do outono.
# SMAP_RECENTE_PATH=
# Soja na safra mais recente, pixel a pixel (saída do pipeline/fetch_soja_recente.py, sem credencial).
# Sem valor: o /talhao responde soja_recente: null e a tela não avisa.
# SOJA_RECENTE_PATH=
# Previsão do El Niño / La Niña da NOAA CPC (saída do pipeline/fetch_enso_previsao.py, sem
# credencial). Sem valor: o sinal para o outono sai nulo ("Ainda não conectado" na tela 7).
# ENSO_PREVISAO_PATH=
# Área queimada do MODIS MCD64A1 na caixa piloto (saída do pipeline/fetch_area_queimada.py, sem
# credencial). Sem valor: o alerta de fogo do raio-X (tela 4) não aparece.
# AREA_QUEIMADA_PATH=
