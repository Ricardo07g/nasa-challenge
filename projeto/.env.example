# Variáveis do docker compose (opcional). Copie para .env só se quiser mudar os padrões.
# Estes valores são APENAS para o banco local de desenvolvimento.
# Credenciais de banco de produção NUNCA entram no repositório.

POSTGRES_DB=raiz_orbital
POSTGRES_USER=raiz
POSTGRES_PASSWORD=raiz_local
# Porta do banco no seu computador (5433 para não brigar com outro Postgres local)
POSTGRES_PORT=5433

# Dados do front: http = API real (o backend do compose); mock = dados de exemplo, sem backend.
VITE_API_MODE=http
# Link público do bot do Telegram (ex.: https://t.me/NomeDoBot). Vazio = o app não fala do Telegram.
# É público (vai para o navegador): só o link, nunca o token do bot.
VITE_TELEGRAM_BOT_URL=
