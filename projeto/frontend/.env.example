# Variáveis do front (opcionais). Para mudar no `npm run dev`, copie para .env.local nesta pasta.
# Tudo que começa com VITE_ é PÚBLICO (vai para o navegador): nunca ponha segredo aqui.
# No docker compose, os mesmos nomes ficam em projeto/.env.example.

# Dados: vazio ou http = API real (o padrão); mock = dados de exemplo, sem backend.
VITE_API_MODE=http
# Link público do bot do Telegram (ex.: https://t.me/NomeDoBot). Vazio = o app não fala do Telegram.
VITE_TELEGRAM_BOT_URL=
# Abrir "Onde fica a lavoura" com a lavoura de demonstração já marcada (primeiros testes). Ligado por padrão;
# false desliga. Com lat/lon na URL, vale o ponto da URL.
VITE_ABRIR_COM_DEMONSTRACAO=true

# Só em produção (Dockerfile.prod + Caddyfile, deploy na Railway): o endereço do backend na rede privada, para onde o
# Caddy repassa /api/*. Não é segredo e não começa com VITE_ (não vai para o navegador).
# BACKEND_URL=http://backend.railway.internal:8000
