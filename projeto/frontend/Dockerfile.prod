# Imagem de PRODUÇÃO do front (deploy na Railway): build do Vite e o Caddy servindo o site estático.
# O Caddy repassa /api/* para o backend pela rede privada da Railway (variável BACKEND_URL), então o front continua
# chamando /api relativo, sem URL fixa e sem CORS. Nenhum segredo aqui: toda VITE_* vai para o navegador.
# A imagem de desenvolvimento (hot reload, docker compose) continua no Dockerfile.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV VITE_API_MODE=http
RUN npm run build

FROM caddy:2.10-alpine
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
